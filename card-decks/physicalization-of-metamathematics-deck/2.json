{"html":"\n  \u003cdiv class=\"page-inner flex flex-col justify-between\">\n    \u003cheader class=\"mast\">\n      \u003cdiv class=\"brand\">\n        \u003cstrong>AlpacaNotes\u003c/strong>\n        \u003cspan class=\"kicker\">THEMATIC ARCHITECTURE · 全书五大主题立柱\u003c/span>\n      \u003c/div>\n      \u003cdiv class=\"masttime font-mono text-xs\">\n        \u003cspan>5 THEMES · 15 UNITS · PAGE 02 / 20\u003c/span>\n      \u003c/div>\n    \u003c/header>\n\n    \u003cdiv class=\"pb-2.5 border-b-2 border-ink dark:border-neutral-700\">\n      \u003ch2 class=\"ed-page-title font-serif text-[34px] font-black text-ink dark:text-white leading-tight\">\n        全书论述架构与演化图谱\n      \u003c/h2>\n      \u003cdiv class=\"flex items-baseline gap-3 pl-3.5 border-l-4 border-accent mt-2\">\n        \u003cspan class=\"text-[12px] font-mono font-bold text-accent uppercase tracking-wider shrink-0 bg-accent/10 px-2 py-0.5 rounded\">核心论断\u003c/span>\n        \u003cp class=\"ed-thesis-text font-serif text-[21px] text-ink dark:text-neutral-200 font-semibold leading-snug\">\n          从纯粹形式公理出发，历经分支拓扑几何化，最终收敛于有限观察者的认知投影。\n        \u003c/p>\n      \u003c/div>\n    \u003c/div>\n\n    \n    \u003cdiv class=\"ed-main ed-layout-agenda grid grid-cols-12 gap-6 my-auto h-[600px] items-stretch\">\n      \u003cdiv class=\"ed-agenda-left col-span-4 h-full\">\n    \u003cdiv class=\"card border-t-4 bg-accent/[0.03] dark:bg-[#262626] flex flex-col justify-between p-6 rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm h-[600px]\" style=\"border-top-color:#1b4f72;\">\n      \u003cdiv class=\"ed-card-text-col\">\n        \u003cdiv class=\"flex items-center justify-between pb-2.5 mb-3 border-b border-slate-100 dark:border-neutral-800\">\n          \u003cspan class=\"text-[12px] font-mono font-bold tracking-wider px-2.5 py-0.5 rounded\" style=\"background:#1b4f7214; color:#1b4f72;\">§ 01\u003c/span>\n          \u003cspan class=\"text-[12px] font-mono text-slate-400 font-semibold\">MACRO ARC\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[25px] font-bold text-ink dark:text-white mb-3.5 leading-snug\">\n          三阶演进主轴\n        \u003c/h3>\n        \u003cul class=\"space-y-3\">\n          \n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">底层本体奠基\u003c/strong>：主题 1 将物理与数学统合于 Ruliad 极限，给出计算受限视角。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">几何动力学化\u003c/strong>：主题 2–4 建立分支流形、因果测地线与广义相对论引力映射。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">认知哲学收束\u003c/strong>：主题 5 以实证测量验证基底，消解数学“发明与发现”二分。\n          \u003c/span>\n        \u003c/li>\n        \u003c/ul>\n      \u003c/div>\n      \n    \u003c/div>\u003c/div>\n      \u003cdiv class=\"ed-agenda-right col-span-8 flex flex-col justify-between gap-3.5 h-full\">\n        \n    \u003cdiv class=\"card ed-horiz-card border-l-4 px-5 py-3.5 bg-white dark:bg-[#242424] rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex items-center flex-1\" style=\"border-left-color:#1b4f72;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-4 border-r border-slate-100 dark:border-neutral-800 shrink-0\">\n        \u003cdiv class=\"flex items-center gap-2 mb-0.5\">\n          \u003cspan class=\"text-[12px] font-mono font-bold\" style=\"color:#1b4f72;\">THEME 01\u003c/span>\n          \u003cspan class=\"text-[11px] font-mono text-slate-500 bg-slate-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">1.1–1.3\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[22px] font-bold text-ink dark:text-white leading-snug\">同一公理基础与 Ruliad\u003c/h3>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-5\">\n        \u003cp class=\"ed-bullet-text text-[21px] leading-[1.45] text-slate-700 dark:text-neutral-300 font-sans\">物理与数学在 Ruliad 极限完全等价，代数结构由符号气体相变凝聚而成。\u003c/p>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 px-5 py-3.5 bg-white dark:bg-[#242424] rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex items-center flex-1\" style=\"border-left-color:#0284c7;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-4 border-r border-slate-100 dark:border-neutral-800 shrink-0\">\n        \u003cdiv class=\"flex items-center gap-2 mb-0.5\">\n          \u003cspan class=\"text-[12px] font-mono font-bold\" style=\"color:#0284c7;\">THEME 02\u003c/span>\n          \u003cspan class=\"text-[11px] font-mono text-slate-500 bg-slate-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">2.1–2.3\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[22px] font-bold text-ink dark:text-white leading-snug\">分支空间与演化动力学\u003c/h3>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-5\">\n        \u003cp class=\"ed-bullet-text text-[21px] leading-[1.45] text-slate-700 dark:text-neutral-300 font-sans\">离散重写诱导分支光锥与引力弯曲，双向替换统摄证明因果子图。\u003c/p>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 px-5 py-3.5 bg-white dark:bg-[#242424] rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex items-center flex-1\" style=\"border-left-color:#b45309;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-4 border-r border-slate-100 dark:border-neutral-800 shrink-0\">\n        \u003cdiv class=\"flex items-center gap-2 mb-0.5\">\n          \u003cspan class=\"text-[12px] font-mono font-bold\" style=\"color:#b45309;\">THEME 03\u003c/span>\n          \u003cspan class=\"text-[11px] font-mono text-slate-500 bg-slate-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">3.1–3.3\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[22px] font-bold text-ink dark:text-white leading-snug\">证明拓扑与在野分布\u003c/h3>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-5\">\n        \u003cp class=\"ed-bullet-text text-[21px] leading-[1.45] text-slate-700 dark:text-neutral-300 font-sans\">合流性赋予真理因果不变性，现行数学仅是 Ruliad 原野中的稀疏奇点。\u003c/p>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 px-5 py-3.5 bg-white dark:bg-[#242424] rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex items-center flex-1\" style=\"border-left-color:#0f766e;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-4 border-r border-slate-100 dark:border-neutral-800 shrink-0\">\n        \u003cdiv class=\"flex items-center gap-2 mb-0.5\">\n          \u003cspan class=\"text-[12px] font-mono font-bold\" style=\"color:#0f766e;\">THEME 04\u003c/span>\n          \u003cspan class=\"text-[11px] font-mono text-slate-500 bg-slate-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">4.1–4.3\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[22px] font-bold text-ink dark:text-white leading-snug\">蕴含织物与相对论效应\u003c/h3>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-5\">\n        \u003cp class=\"ed-bullet-text text-[21px] leading-[1.45] text-slate-700 dark:text-neutral-300 font-sans\">Emes 基底编织连续流形，证明密度弯曲时空并确立推导光速极限。\u003c/p>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 px-5 py-3.5 bg-white dark:bg-[#242424] rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex items-center flex-1\" style=\"border-left-color:#1b4f72;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-4 border-r border-slate-100 dark:border-neutral-800 shrink-0\">\n        \u003cdiv class=\"flex items-center gap-2 mb-0.5\">\n          \u003cspan class=\"text-[12px] font-mono font-bold\" style=\"color:#1b4f72;\">THEME 05\u003c/span>\n          \u003cspan class=\"text-[11px] font-mono text-slate-500 bg-slate-100 dark:bg-neutral-800 px-2 py-0.5 rounded\">5.1–5.3\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[22px] font-bold text-ink dark:text-white leading-snug\">有限观察者与哲学重构\u003c/h3>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-5\">\n        \u003cp class=\"ed-bullet-text text-[21px] leading-[1.45] text-slate-700 dark:text-neutral-300 font-sans\">实证测绘揭示元数学基底，终结数学“发明”与“发现”的二元对立。\u003c/p>\n      \u003c/div>\n    \u003c/div>\n      \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"ed-bottom-bar pt-2 flex items-center justify-between border-t border-slate-200 dark:border-neutral-800\">\n      \n      \u003cdiv class=\"ed-takeaway-wrap flex items-center gap-3 px-4 py-2 bg-amber-500/10 dark:bg-amber-950/40 border-l-4 border-amber-600 rounded-r-md max-w-5xl\">\n        \u003ci class=\"fa-solid fa-lightbulb text-amber-600 text-base shrink-0\">\u003c/i>\n        \u003cdiv class=\"ed-takeaway-text text-[20px] leading-tight text-amber-950 dark:text-amber-200 font-sans\">\n          \u003cstrong class=\"font-bold text-amber-700 dark:text-amber-400\">本节要旨：\u003c/strong>\u003cspan>五大主题层层递进，完整重构数学基础的物理化图景。\u003c/span>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv class=\"folio font-mono text-xs text-slate-500 shrink-0\">\n        \u003cspan>Stephen Wolfram · The Physicalization of Metamathematics\u003c/span>\n      \u003c/div>\n    \u003c/div>\n  \u003c/div>\n"}