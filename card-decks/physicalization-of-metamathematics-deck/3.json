{"html":"\n  \u003cdiv class=\"page-inner flex flex-col justify-between\">\n    \u003cheader class=\"mast\">\n      \u003cdiv class=\"brand\">\n        \u003cstrong>AlpacaNotes\u003c/strong>\n        \u003cspan class=\"kicker\">PART 01 · 同一公理基础与 Ruliad\u003c/span>\n      \u003c/div>\n      \u003cdiv class=\"masttime font-mono text-xs\">\n        \u003cspan>PROPOSITION 1.1 · 总分主从 · PAGE 03 / 20\u003c/span>\n      \u003c/div>\n    \u003c/header>\n\n    \u003cdiv class=\"pb-2.5 border-b-2 border-ink dark:border-neutral-700\">\n      \u003ch2 class=\"ed-page-title font-serif text-[34px] font-black text-ink dark:text-white leading-tight\">\n        \u003cspan class=\"text-accent font-mono mr-3\">[1.1]\u003c/span>Ruliad 极限本体论\n      \u003c/h2>\n      \u003cdiv class=\"flex items-baseline gap-3 pl-3.5 border-l-4 border-accent mt-2\">\n        \u003cspan class=\"text-[12px] font-mono font-bold text-accent uppercase tracking-wider shrink-0 bg-accent/10 px-2 py-0.5 rounded\">核心论断\u003c/span>\n        \u003cp class=\"ed-thesis-text font-serif text-[21px] text-ink dark:text-neutral-200 font-semibold leading-snug\">\n          物理实在与数学体系同源于计算纠缠极限 Ruliad，受计算受限观测者投影支配。\n        \u003c/p>\n      \u003c/div>\n    \u003c/div>\n\n    \n    \u003cdiv class=\"ed-main ed-layout-primary grid grid-cols-12 gap-6 my-auto h-[600px] items-stretch\">\n      \u003cdiv class=\"ed-primary-left col-span-5 h-full\">\n    \u003cdiv class=\"card border-t-4 bg-accent/[0.03] dark:bg-[#262626] flex flex-col justify-between p-6 rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm h-[600px]\" style=\"border-top-color:#1b4f72;\">\n      \u003cdiv class=\"ed-card-text-col\">\n        \u003cdiv class=\"flex items-center justify-between pb-2.5 mb-3 border-b border-slate-100 dark:border-neutral-800\">\n          \u003cspan class=\"text-[12px] font-mono font-bold tracking-wider px-2.5 py-0.5 rounded\" style=\"background:#1b4f7214; color:#1b4f72;\">§ 01\u003c/span>\n          \u003cspan class=\"text-[12px] font-mono text-slate-400 font-semibold\">CORE MECHANISM\u003c/span>\n        \u003c/div>\n        \u003ch3 class=\"ed-card-title font-serif text-[25px] font-bold text-ink dark:text-white mb-3.5 leading-snug\">\n          Ruliad 本体统一\n        \u003c/h3>\n        \u003cul class=\"space-y-3\">\n          \n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">消解二元对立\u003c/strong>：物理非预设规则运行，数学亦非孤立人造公理。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">唯一计算极限\u003c/strong>：二者底层皆为交织一切计算与推理的 Ruliad。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">同源宏观截面\u003c/strong>：宇宙物理定律与必然数学真理源自同一客体。\n          \u003c/span>\n        \u003c/li>\n        \u003c/ul>\n      \u003c/div>\n      \n      \u003cdiv class=\"ed-card-visual mt-auto pt-3 border-t border-slate-100 dark:border-neutral-700/80 flex flex-col gap-2\">\n        \u003cdiv class=\"ed-svg-box rounded-lg bg-slate-50/75 dark:bg-[#2b2b2b] p-2 border border-slate-100 dark:border-neutral-700/80\">\n          \u003csvg viewBox=\"0 0 460 155\" class=\"w-full h-[145px]\" fill=\"none\">\n          \u003ccircle cx=\"230\" cy=\"42\" r=\"28\" fill=\"#2b6cb0\" fill-opacity=\"0.12\" stroke=\"#2b6cb0\" stroke-width=\"2\"/>\n          \u003cpath d=\"M214 34 Q230 20 246 34 M210 46 Q230 58 250 46 M222 22 L238 60 M238 22 L222 60\" stroke=\"#2b6cb0\" stroke-width=\"1.4\" stroke-opacity=\"0.7\"/>\n          \u003ctext x=\"230\" y=\"46\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"700\" fill=\"#2b6cb0\">RULIAD\u003c/text>\n          \u003cpath d=\"M208 62 L115 104\" stroke=\"#0284c7\" stroke-width=\"1.8\" stroke-dasharray=\"4 3\"/>\n          \u003cpath d=\"M252 62 L345 104\" stroke=\"#d97706\" stroke-width=\"1.8\" stroke-dasharray=\"4 3\"/>\n          \u003crect x=\"45\" y=\"106\" width=\"140\" height=\"36\" rx=\"6\" fill=\"#0284c7\" fill-opacity=\"0.1\" stroke=\"#0284c7\" stroke-width=\"1.5\"/>\n          \u003ctext x=\"115\" y=\"128\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"700\" fill=\"#0284c7\">物理宇宙截面\u003c/text>\n          \u003crect x=\"275\" y=\"106\" width=\"140\" height=\"36\" rx=\"6\" fill=\"#d97706\" fill-opacity=\"0.1\" stroke=\"#d97706\" stroke-width=\"1.5\"/>\n          \u003ctext x=\"345\" y=\"128\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"700\" fill=\"#d97706\">数学公理截面\u003c/text>\n        \u003c/svg>\n        \u003c/div>\n        \u003cdiv class=\"ed-note-text text-[17px] leading-[1.45] text-slate-600 dark:text-neutral-300 font-sans px-1\">\n          \u003cspan class=\"text-[12px] font-mono font-bold px-1.5 py-0.5 rounded mr-1.5\" style=\"background:#1b4f7216; color:#1b4f72;\">通俗类比\u003c/span>\n          \u003cspan>如同同一座三维冰山，侧面投影是物理定律，正面投影是数学定理。\u003c/span>\n        \u003c/div>\n      \u003c/div>\n    \u003c/div>\u003c/div>\n      \u003cdiv class=\"ed-primary-right col-span-7 flex flex-col justify-between gap-4 h-full\">\n        \n    \u003cdiv class=\"card ed-horiz-card border-l-4 bg-white dark:bg-[#242424] flex items-stretch p-5 rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex-1\" style=\"border-left-color:#0284c7;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-5 border-r border-slate-100 dark:border-neutral-800 flex flex-col justify-between shrink-0\">\n        \u003cdiv>\n          \u003cdiv class=\"flex items-center gap-2 mb-2\">\n            \u003cspan class=\"text-[12px] font-mono font-bold tracking-wider px-2 py-0.5 rounded\" style=\"background:#0284c714; color:#0284c7;\">§ 02\u003c/span>\n            \u003cspan class=\"text-[11px] font-mono text-slate-400\">COROLLARY 01\u003c/span>\n          \u003c/div>\n          \u003ch3 class=\"ed-card-title font-serif text-[24px] font-bold text-ink dark:text-white leading-snug\">\n            观测者双重约束\n          \u003c/h3>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-6 flex flex-col justify-center\">\n        \u003cul class=\"space-y-2.5\">\n          \n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">计算能力受限\u003c/strong>：无法遍历全量微观态，被迫构筑局域参考系。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">时间连贯一致\u003c/strong>：必须在多路规则空间中维持稳定概念同一性。\n          \u003c/span>\n        \u003c/li>\n        \u003c/ul>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 bg-white dark:bg-[#242424] flex items-stretch p-5 rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex-1\" style=\"border-left-color:#b45309;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-5 border-r border-slate-100 dark:border-neutral-800 flex flex-col justify-between shrink-0\">\n        \u003cdiv>\n          \u003cdiv class=\"flex items-center gap-2 mb-2\">\n            \u003cspan class=\"text-[12px] font-mono font-bold tracking-wider px-2 py-0.5 rounded\" style=\"background:#b4530914; color:#b45309;\">§ 03\u003c/span>\n            \u003cspan class=\"text-[11px] font-mono text-slate-400\">COROLLARY 02\u003c/span>\n          \u003c/div>\n          \u003ch3 class=\"ed-card-title font-serif text-[24px] font-bold text-ink dark:text-white leading-snug\">\n            热力学统计涌现\n          \u003c/h3>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-6 flex flex-col justify-center\">\n        \u003cul class=\"space-y-2.5\">\n          \n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">微观分子碰撞\u003c/strong>：底层超图重写与公理展开等价于分子动力学。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">宏观流体规律\u003c/strong>：经典物理与高等数学是洗脱不可约性后的流体。\n          \u003c/span>\n        \u003c/li>\n        \u003c/ul>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"card ed-horiz-card border-l-4 bg-white dark:bg-[#242424] flex items-stretch p-5 rounded-xl border border-slate-200/90 dark:border-neutral-800 shadow-sm flex-1\" style=\"border-left-color:#0f766e;\">\n      \u003cdiv class=\"ed-horiz-left w-[33%] pr-5 border-r border-slate-100 dark:border-neutral-800 flex flex-col justify-between shrink-0\">\n        \u003cdiv>\n          \u003cdiv class=\"flex items-center gap-2 mb-2\">\n            \u003cspan class=\"text-[12px] font-mono font-bold tracking-wider px-2 py-0.5 rounded\" style=\"background:#0f766e14; color:#0f766e;\">§ 04\u003c/span>\n            \u003cspan class=\"text-[11px] font-mono text-slate-400\">COROLLARY 03\u003c/span>\n          \u003c/div>\n          \u003ch3 class=\"ed-card-title font-serif text-[24px] font-bold text-ink dark:text-white leading-snug\">\n            概念漂移与奇点\n          \u003c/h3>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv class=\"ed-horiz-right w-[67%] pl-6 flex flex-col justify-center\">\n        \u003cul class=\"space-y-2.5\">\n          \n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">概念点云演化\u003c/strong>：勾股定理等真理在公理微扰下保持稳健漂移。\n          \u003c/span>\n        \u003c/li>\n        \u003cli class=\"flex items-start gap-3\">\n          \u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent mt-2.5 shrink-0\">\u003c/span>\n          \u003cspan class=\"ed-bullet-text text-[21px] leading-[1.56] text-[#1a2233] dark:text-neutral-200 font-sans\">\n            \u003cstrong class=\"font-bold text-ink dark:text-white\">奇点退相干\u003c/strong>：不可判定命题对应探测尺度穿透至离散底层。\n          \u003c/span>\n        \u003c/li>\n        \u003c/ul>\n      \u003c/div>\n    \u003c/div>\n      \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"ed-bottom-bar pt-2 flex items-center justify-between border-t border-slate-200 dark:border-neutral-800\">\n      \n      \u003cdiv class=\"ed-takeaway-wrap flex items-center gap-3 px-4 py-2 bg-amber-500/10 dark:bg-amber-950/40 border-l-4 border-amber-600 rounded-r-md max-w-5xl\">\n        \u003ci class=\"fa-solid fa-lightbulb text-amber-600 text-base shrink-0\">\u003c/i>\n        \u003cdiv class=\"ed-takeaway-text text-[20px] leading-tight text-amber-950 dark:text-amber-200 font-sans\">\n          \u003cstrong class=\"font-bold text-amber-700 dark:text-amber-400\">本节要旨：\u003c/strong>\u003cspan>数学与物理同为受限观测者对 Ruliad 粗粒化投影的宏观相。\u003c/span>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv class=\"folio font-mono text-xs text-slate-500 shrink-0\">\n        \u003cspan>Stephen Wolfram · The Physicalization of Metamathematics\u003c/span>\n      \u003c/div>\n    \u003c/div>\n  \u003c/div>\n"}