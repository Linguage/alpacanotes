        }
      ]
    }
  },
  {
    "id": "1954371713959182536",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@feltanimalworld 各种自然语言为AI提供了丰富的养料，反过来可能AI也会影响人类语言的特点（就像互联网等工具一样，贡献了很多网络词汇），但不能说无法与AI产生关联，这门语言就一定衰败。",
    "created_at": "2025-08-10T02:38:21.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
