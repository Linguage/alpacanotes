        }
      ]
    }
  },
  {
    "id": "1954374251810857234",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@feltanimalworld 这一代看起来确实挺强的。\n\n整体文化水平高，比较遵守社会公德，心态相对积极向上，而且人数多......\n\n唯一的缺点就是负债率高，手上没钱，对未来的期望被锁死，在事业上失去了冒险的能力，在精神上被消磨掉了创新的欲望",
    "created_at": "2025-08-10T02:48:26.000Z",
    "metrics": {
      "like_count": 1,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
    },
    "media": null,
    "entities": {
      "urls": [],
      "hashtags": [],
      "mentions": [
        {
          "username": "feltanimalworld"
        }
      ]
    }
  },
  {
    "id": "1954372653382607344",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@feltanimalworld 此外，很多词语是民间与官方审查的对抗中产生的，这是一种“民间智慧”。 这一点，生活在墙内互联网，我们太熟悉了。\n\n语言的生命力很大一部分来自于生活，这些并不是AI单方面所能代劳的。AI可能被官方所掌控，但这样大概率会进一步刺激民间为语言注入新的活力。",
    "created_at": "2025-08-10T02:42:05.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
    },
    "media": null,
    "entities": {
      "urls": [],
      "hashtags": [],
      "mentions": [
        {
          "username": "feltanimalworld"
        }
      ]
    }
  },
  {
    "id": "1954371937611956267",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@feltanimalworld 对各种语言中，我感兴趣的部分是说脏话的部分。\n\n它面对的表达场景情绪比较丰富，越是发达的语言，这部分越发达，而很多小型语言，这方面很欠缺（听说蒙古语没有多少脏话）。\n\nAI目前没有说脏话的需求，这一点可能是AI与人类在语言偏好上的巨大区别。",
    "created_at": "2025-08-10T02:39:15.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
    },
    "media": null,
    "entities": {
      "urls": [],
