      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "使用Google Deep Research整理了一个报告\n\nhttps://t.co/jMfN0IDS9R",
    "created_at": "2025-06-30T01:46:47.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
