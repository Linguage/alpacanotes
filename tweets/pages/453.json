      "urls": [
        {
          "url": "https://t.co/jMfN0IDS9R",
          "indices": [
            31,
            54
          ],
          "display_url": "linguista.bearblog.dev/the-evolution-…",
          "expanded_url": "https://linguista.bearblog.dev/the-evolution-of-reading-3-period/"
        }
      ],
      "hashtags": [],
      "mentions": []
    }
