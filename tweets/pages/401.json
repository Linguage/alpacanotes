      "mentions": []
    }
  },
  {
    "id": "1962218400597635147",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@buaaxhm 还是看效果吧。\n\n广智不low，也是在一个行业里做到比较好的人，而且肯定是有故事的人。",
    "created_at": "2025-08-31T18:18:17.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
