          "url": "https://t.co/XQaEH4MdS1",
          "indices": [
            143,
            166
          ],
          "display_url": "x.com/AztecaAlpaca/s…",
          "expanded_url": "https://x.com/AztecaAlpaca/status/1953760527970447422"
