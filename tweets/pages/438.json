    }
  },
  {
    "id": "1953760520559083831",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "社会等级与身份不平等：在大革命前，法国的贵族和普通人之间存在巨大身份差异。革命表面消解了身份等级，但托克维尔注意到平等成为社会的新追求时，哪怕微小的不平等也易引发激烈的社会仇恨。",
    "created_at": "2025-08-08T10:09:41.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
