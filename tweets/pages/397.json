[
  {
    "id": "1964883048840958032",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "他以我们最熟悉的“教科书”为例，犀利地指出了现有方法的笨拙。我们当下的主流做法，不过是把PDF转换成纯文本，让模型像一个耐心的学童，逐字逐句地预测整本教材的内容。这种 brute-force 的学习，在作者看来，实在有些“乏味”。",
    "created_at": "2025-09-08T02:46:39.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
    },
    "media": null,
    "entities": {
