        "url": "https://pbs.twimg.com/media/G9PKov_bAAAYJN3.jpg",
        "type": "photo",
        "preview_image_url": "https://pbs.twimg.com/media/G9PKov_bAAAYJN3.jpg"
      }
    ],
    "entities": {
