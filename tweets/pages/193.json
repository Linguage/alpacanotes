        {
          "username": "dotey"
        },
        {
          "username": "Louis_Chenxf"
        }
      ]
    }
  },
  {
    "id": "1999690371182518602",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "@dotey @Louis_Chenxf 现在大模型干纯视觉的和纯编码的都不错。\n\n从视觉到编码也能做得相当好（比如复刻一个网页或者信息图）。\n\n但是从编码到视觉，调整起来就比较恶心了（被css支配的恐惧）...🤣🤣🤣",
    "created_at": "2025-12-13T03:58:31.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 1,
      "reply_count": null,
      "quote_count": null,
