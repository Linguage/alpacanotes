[
  {
    "id": "1980834962753687857",
    "author": {
      "id": "1725169104963657728",
      "username": "AztecaAlpaca",
      "name": "阿兹特克小羊驼",
      "profile_image_url": "https://pbs.twimg.com/profile_images/2019350943930937348/0z3zAknf_400x400.jpg",
      "verified": false
    },
    "text": "我刚使用Dia的时候，也在使用Firefox。\n\nFirefox也集成了一各AI侧边栏，只是他们自己不做AI的Agent，侧边栏的AI需要专门登录。一开始感觉还不错，但后来就烦了。\n\nFirefox浏览器让我最喜欢的是支持垂直标签和书签管理功能，加上多端同步的优秀特性，非常舒适。 https://t.co/hRalf6h8M7",
    "created_at": "2025-10-22T03:13:51.000Z",
    "metrics": {
      "like_count": 0,
      "retweet_count": 0,
      "reply_count": null,
      "quote_count": null,
      "view_count": null,
      "impression_count": null
    },
    "media": [
      {
        "url": "https://pbs.twimg.com/media/G31WpldWkAAi-I9.jpg",
        "type": "photo",
        "preview_image_url": "https://pbs.twimg.com/media/G31WpldWkAAi-I9.jpg"
      }
    ],
